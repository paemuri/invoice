#!/bin/sh

regex() {
  if command -v pcre2grep >/dev/null
  then
    echo "$1" | pcre2grep "$2" >/dev/null
  fi
}

build_file() {
  refmonth="$1"

  suffix="001"
  output_dir="out"
  output_format="pdf"
  while output_file="$refmonth-invoice-$suffix" && \
    test -f "$output_dir/$output_file.$output_format"
  do
    suffix=$(printf "%03d" $(( 10#$suffix + 1 )))
  done

  if ! test -d "$output_dir"
  then
    mkdir "$output_dir"
  fi

  echo "Building file for $refmonth: $output_dir/$output_file.$output_format."

  export INVOICE_REFMONTH="$refmonth"
  lualatex \
    --lua=main.lua \
    --jobname="$output_file" \
    --output-dir="$output_dir" \
    --output-format="$output_format" \
    --file-line-error \
    main.tex >/dev/null
  unset INVOICE_REFMONTH

  echo Done. Cleaning...
  for file in $(ls "$output_dir" | pcre2grep -v '.*\.pdf')
  do
    rm "$output_dir/$file"
  done

  echo Done.
}

refmonth_list="$@"

# If no reference month is defined, execute all of them.
if test -z "$refmonth_list"
then
  refmonth_list="$( \
    ls ./data/ | \
    grep -v .gitkeep | \
    grep -v main.lua | \
    sed 's/\.lua//' \
  )"
fi

# Validate inputs.
for arg in $refmonth_list
do
  if test "$arg" = "-h" || test "$arg" = "--help"
  then
    echo    "Invoice build"
    echo    "Usage:"
    echo -e "\tbuild [REF_MONTH]..."
    exit 0
  fi

  if ! regex "$arg" '\d{4}-\d{2}'
  then
    echo "Invalid reference month." >&2
    exit 2
  fi

  if ! test -f "data/$arg.lua"
  then
    echo "Missing data file (data/$arg.lua)." >&2
    exit 3
  fi
done

# Build files.
for refmonth in $refmonth_list
do
  build_file "$refmonth"
done
