#!/bin/sh
set -eu

build_file() {
  refmonth="$1"
  number=1

  case "$refmonth" in
    [0-9][0-9][0-9][0-9]-0[1-9]|[0-9][0-9][0-9][0-9]-1[0-2]) ;;
    *)
      echo "Invalid reference month: $refmonth" >&2
      exit 2
      ;;
  esac

  if ! test -f "data/$refmonth.toml"
  then
    echo "Missing data file: data/$refmonth.toml" >&2
    exit 3
  fi

  while test -f "out/$refmonth-invoice-$(printf '%03d' "$number").pdf"
  do
    number=$((number + 1))
  done

  output="out/$refmonth-invoice-$(printf '%03d' "$number").pdf"
  echo "Building $output."
  typst compile --root . --input "refmonth=$refmonth" invoice.typ "$output"
}

mkdir -p out

refmonth_list="$@"

# If no reference month is defined, execute all of them.
if test -z "$refmonth_list"
then
  refmonth_list="$(ls data/*.toml | sed 's|data/||; s|\.toml$||' | grep -v '^main$')"
fi

for refmonth in $refmonth_list
do
  build_file "$refmonth"
done
